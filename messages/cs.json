  "privacyPolicy": {
    "title": "Zásady ochrany osobních údajů",
    "lastUpdated": "Poslední aktualizace: 28. prosince 2025",
    "sections": {
      "introduction": {
        "title": "Úvod",
        "content": "Next Football je soukromá aplikace pouze pro pozvané uživatele určená pro přátelé, aby organizovali a sledovali fotbalové zápasy. Tyto Zásady ochrany osobních údajů vysvětlují, jaké informace shromažďujeme, jak je používáme a jak je chránodáme"
      },
      "scope": {
        "title": "Rozsah a přístup",
        "content": "Tato aplikace je určena výhradně pozvaným uživatelům. Není dostupný žádný veřejný přístup. Všichni uživatelé musí být pozváni stávajícími členy, aby si vytvořili účet"
      },
      "dataCollection": {
        "title": "Data, která shromažďujeme",
        "content": "Shromažďujeme minimální osobní údaje nezbytné k provozování aplikace:\n• Jméno a příjmení (uvedeno při registraci)\n• E-mailová adresa (pro ověřování účtu)\n• Záznamy o gólech během zápasů (střelec, asistent, čas, typ)\n• Záznamy o zápasech (místo, datum, účastníci, stav)\n• Ověření pomocí poskytovatelů OAuth, pokud je to vhodné\n\nNESHROMažďujeme:\n• IP adresy\n• Cookies (mimo správu technických relací)\n• Data prohlížeče\n• Informace o zařízení\n• Data o poloze\n• Analytiku používání"
      },
      "dataStorage": {
        "title": "Úložiště dat",
        "content": "Všechna data jsou bezpečně uložena v Supabase, službě backendu založené na PostgreSQL. Data jsou uložena pouze po dobu, kdy je váš účet aktivní, a nikdy se nesdělují třetím stranám pro komerční účely"
      },
      "dataUsage": {
        "title": "Jak používáme vaše data",
        "content": "Vaše data se používají výhradně pro:\n• Vytváření a správu vašeho účtu\n• Sledování a zobrazování statistik zápasů\n• Výpočet individuálních a týmových metrik výkonu\n• Zobrazení výsledků zápasů a ranking hráčů\n• Umožnění komunikace v aplikaci"
      },
      "security": {
        "title": "Bezpečnost",
        "content": "Implementujeme standardní opatření na ochranu vašich osobních údajů:\n• Šifrované přenosy dat (HTTPS/TLS)\n• Bezpečné ukládání hesel pomocí hashing\n• Řízení přístupu na základě rolí\n• Pravidelné bezpečnostní recenze\n\nVšak žádná metoda přenosu přes internet není zcela bezpečná. Doporučujeme vám používat silná hesla a chránit přihlašovací údaje vašeho účtu"
      },
      "userRights": {
        "title": "Vaše práva",
        "content": "Máte právo:\n• Přistupovat k vašim osobním údajům\n• Požádat o opravu nepřesných údajů\n• Požádat o smazání vašeho účtu a souvisejících dat\n• Kdykoliv se odhlásit z aplikace\n\nChcete-li tato práva uplatnit, kontaktujte nás pomocí níže uvedených informací"
      },
      "changes": {
        "title": "Změny těchto zásad",
        "content": "Tyto Zásady ochrany osobních údajů můžeme čas od času aktualizovat. Významné změny budou sděleny uživatelům. Pokračování v používání aplikace po takových změnách představuje přijetí aktualizovaných zásad"
      },
